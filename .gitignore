# Batch-scan output — per-domain raw results (company names + individual
# scores) stay out of the repo. Aggregate summaries have no company names
# in them and are what scripts/generate-benchmarks.js reads from, so
# those and the hand-maintained benchmarks.json index are tracked.
data/*-raw.json

# OS
.DS_Store

# Vercel local state
.vercel

# Node
node_modules/

# Env / secrets
.env
.env.local
