{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/v1/cron/run",
      "schedule": "17 5 * * *"
    }
  ],
  "functions": {
    "api/scan.js": {
      "maxDuration": 30
    },
    "api/crawl-start.js": {
      "maxDuration": 30
    },
    "api/crawl-step.js": {
      "maxDuration": 30
    },
    "api/mcp.js": {
      "maxDuration": 60
    },
    "api/v1/[...path].js": {
      "maxDuration": 60
    },
    "api/llms-check.js": {
      "maxDuration": 30
    },
    "api/site-info.js": {
      "maxDuration": 30
    },
    "api/pro.js": {
      "maxDuration": 60,
      "includeFiles": "{app/pro-start.html,content/prompts/*.json}"
    }
  },
  "redirects": [
    { "source": "/v1", "destination": "/api", "statusCode": 302 },
    { "source": "/v1/", "destination": "/api", "statusCode": 302 },
    { "source": "/scan", "destination": "/", "statusCode": 301 },
    { "source": "/scan/", "destination": "/", "statusCode": 301 },
    { "source": "/beyond-technical", "destination": "/beyond", "statusCode": 301 },
    { "source": "/beyond-technical/", "destination": "/beyond", "statusCode": 301 },
    {
      "source": "/((?!api/mcp|\\.well-known/(?:oauth|openid|mcp)).*)",
      "has": [{ "type": "host", "value": "answerable-app.vercel.app" }],
      "destination": "https://getcitehound.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/r/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/pro/start/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(w|demo)/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/admin/ws",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/pro/welcome",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/waitlist/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/readiness/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/readiness",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/app/pro-start(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/openapi.yaml",
      "headers": [
        { "key": "Content-Type", "value": "application/yaml; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/api/pro(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/v1/:path*" },
    { "source": "/api", "destination": "/api.html" },
    { "source": "/admin/crawlers", "destination": "/api/admin-crawlers" },
    { "source": "/api/action-scan", "destination": "/api/scan?client=action" },
    { "source": "/admin/ws", "destination": "/api/pro?a=wsadmin" },
    { "source": "/demo/fix", "destination": "/api/pro?a=demofix" },
    { "source": "/demo/beyond", "destination": "/api/pro?a=demobeyond" },
    { "source": "/w/:id([0-9a-f]{32})", "destination": "/api/pro?a=ws&id=:id" },
    { "source": "/w/:id([0-9a-f]{32})/", "destination": "/api/pro?a=ws&id=:id" },
    { "source": "/pro/start/:token", "destination": "/api/pro?a=startpage&token=:token" },
    { "source": "/api/waitlist", "destination": "/api/pro?a=waitlist" },
    { "source": "/pro/welcome", "destination": "/api/pro?a=welcomepage" },
    { "source": "/waitlist/remove/:token", "destination": "/api/pro?a=waitremove&token=:token" },
    { "source": "/api/readiness", "destination": "/api/pro?a=readiness" },
    { "source": "/readiness/download/:token([0-9a-f]{72})", "destination": "/api/pro?a=readinessget&token=:token" },
    { "source": "/readiness/remove/:token", "destination": "/api/pro?a=readinessremove&token=:token" },
    { "source": "/api/pro/:action(start|order|step|status|email|feedback|webhook|welcome)", "destination": "/api/pro?a=:action" },
    { "source": "/api/pro/:action(wsverify|wscontent|wsadminlogin|wsadminapi)", "destination": "/api/pro?a=:action" },
    { "source": "/r/:id([0-9a-f]{32})", "destination": "/api/pro?a=report&id=:id" },
    { "source": "/r/:id([0-9a-f]{32})/", "destination": "/api/pro?a=report&id=:id" }
  ]
}
