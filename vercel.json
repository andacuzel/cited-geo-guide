{
  "cleanUrls": true,
  "functions": {
    "api/scan.js": {
      "maxDuration": 30
    },
    "api/crawl-start.js": {
      "maxDuration": 30
    },
    "api/crawl-step.js": {
      "maxDuration": 30
    },
    "api/mcp.js": {
      "maxDuration": 60
    },
    "api/llms-check.js": {
      "maxDuration": 30
    },
    "api/site-info.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/((?!api/mcp|\\.well-known/(?:oauth|openid|mcp)).*)",
      "has": [{ "type": "host", "value": "answerable-app.vercel.app" }],
      "destination": "https://getcitehound.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/admin/crawlers", "destination": "/api/admin-crawlers" }
  ]
}
